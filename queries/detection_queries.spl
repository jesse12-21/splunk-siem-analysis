# Splunk SIEM Detection Queries — Reference Library
# ==================================================
# Ad-hoc and hunting queries for the BOTSv1 dataset.
#
# NOTE ON SCOPE. Production detections are NOT here. They live in
# detections/ as contentctl YAML, carry MITRE ATT&CK mappings and risk
# scoring, and are validated by CI. This file is the hunting and
# exploration layer — queries an analyst runs by hand.
#
# Two conventions applied throughout, both absent from the earlier version
# of this file and both material:
#
#   1. tstats against accelerated data models rather than raw `index=`
#      searches. A raw search reads every event then filters; tstats reads
#      pre-computed summaries. On 33.4M events the difference is minutes
#      versus seconds.
#
#   2. CIM data models rather than hardcoded index and field names. The
#      earlier version searched `index=windows_security EventCode=4625`,
#      which only works on Windows logs in an index with that exact name.
#      `datamodel=Authentication` works on any normalised auth source.
#
# Where a raw search is genuinely the right tool — free-text hunting, or a
# source with no CIM mapping — that is noted inline rather than left to
# look like an oversight.


# ============================================================
# AUTHENTICATION
# ============================================================

# --- Failed authentication volume by source ---
| tstats `security_content_summariesonly` count as failures
  from datamodel=Authentication.Authentication
  where Authentication.action="failure"
  by Authentication.src, Authentication.user, _time span=1h
| `drop_dm_object_name(Authentication)`
| where failures > 20
| sort - failures

# --- Failed then successful, same hour ---
# Time bounding by _time span=1h is the important part. Without it this
# pairs a failure from Tuesday with a success from Friday.
| tstats `security_content_summariesonly`
    count(eval(Authentication.action="failure")) as failures,
    count(eval(Authentication.action="success")) as successes
  from datamodel=Authentication.Authentication
  by Authentication.src, Authentication.user, _time span=1h
| `drop_dm_object_name(Authentication)`
| where failures > 20 AND successes > 0

# --- Authentication timeline ---
| tstats `security_content_summariesonly` count
  from datamodel=Authentication.Authentication
  by Authentication.action, _time span=1h
| `drop_dm_object_name(Authentication)`
| timechart span=1h sum(count) by action

# --- Account lockouts ---
# Raw search: lockout (4740) is not represented in the Authentication model.
`botsv1_windows_security` EventCode=4740
| table _time, user, src
| sort - _time


# ============================================================
# PRIVILEGE AND ACCOUNT CHANGES
# ============================================================

# --- Group membership modifications ---
| tstats `security_content_summariesonly` count, values(All_Changes.object) as groups
  from datamodel=Change.All_Changes
  where All_Changes.object_category="group" AND All_Changes.action="modified"
  by All_Changes.user, All_Changes.dest
| `drop_dm_object_name(All_Changes)`

# --- Account creation ---
| tstats `security_content_summariesonly` count
  from datamodel=Change.All_Changes
  where All_Changes.object_category="user" AND All_Changes.action="created"
  by All_Changes.user, All_Changes.object, All_Changes.dest
| `drop_dm_object_name(All_Changes)`


# ============================================================
# WEB
# ============================================================

# --- Injection patterns in URLs ---
# Matching inside the tstats `where` pushes the filter into the summaries.
# The earlier version used a post-search `| where like(url,"%UNION%")`,
# which retrieves every web event first.
| tstats `security_content_summariesonly` count, values(Web.url) as urls
  from datamodel=Web.Web
  where Web.url IN ("*UNION*","*SELECT*","*information_schema*","*OR%201=1*")
  by Web.src, Web.dest, Web.status
| `drop_dm_object_name(Web)`

# --- Path traversal ---
| tstats `security_content_summariesonly` count, values(Web.url) as urls
  from datamodel=Web.Web
  where Web.url IN ("*../*","*/etc/passwd*","*%2e%2e%2f*")
  by Web.src, Web.dest
| `drop_dm_object_name(Web)`

# --- Content discovery by 404 volume and URL diversity ---
# URL diversity separates a scanner from a broken link hit repeatedly.
| tstats `security_content_summariesonly` count as not_found, dc(Web.url) as unique_urls
  from datamodel=Web.Web where Web.status=404
  by Web.src
| `drop_dm_object_name(Web)`
| where not_found > 100 AND unique_urls > 50
| sort - not_found

# --- Status code distribution ---
| tstats `security_content_summariesonly` count from datamodel=Web.Web
  by Web.status, _time span=1h
| `drop_dm_object_name(Web)`
| timechart span=1h sum(count) by status


# ============================================================
# NETWORK
# ============================================================

# --- Large outbound transfers on non-standard ports ---
| tstats `security_content_summariesonly` sum(All_Traffic.bytes_out) as bytes_out, count
  from datamodel=Network_Traffic.All_Traffic
  where All_Traffic.action="allowed" AND NOT All_Traffic.dest_port IN (80,443,53)
  by All_Traffic.src, All_Traffic.dest, All_Traffic.dest_port
| `drop_dm_object_name(All_Traffic)`
| where bytes_out > 10000000
| eval MB = round(bytes_out/1048576, 2)
| sort - MB

# --- Suricata IDS alerts by severity ---
# Sourced from the companion suricata-ids-rules project.
# See docs/integrations.md for the ingest configuration.
| tstats `security_content_summariesonly` count
  from datamodel=Intrusion_Detection.IDS_Attacks
  by IDS_Attacks.severity, IDS_Attacks.signature
| `drop_dm_object_name(IDS_Attacks)`
| sort - count

# --- Firewall denies over time ---
| tstats `security_content_summariesonly` count
  from datamodel=Network_Traffic.All_Traffic
  where All_Traffic.action="blocked" by _time span=1h
| timechart span=1h sum(count) as denies


# ============================================================
# RISK-BASED INVESTIGATION
# ============================================================
# These operate on the Risk data model that the detections in detections/
# write to. See docs/rba-guide.md for the methodology.

# --- Entities by accumulated risk ---
| from datamodel Risk.All_Risk
| stats sum(All_Risk.calculated_risk_score) as total_risk,
        dc(All_Risk.search_name) as distinct_detections,
        values(All_Risk.search_name) as detections
  by All_Risk.risk_object, All_Risk.risk_object_type
| rename All_Risk.* as *
| where distinct_detections >= 3
| sort - total_risk

# --- Full risk history for one entity ---
# Replace <ENTITY> with a value from the query above.
| from datamodel Risk.All_Risk
| search All_Risk.risk_object="<ENTITY>"
| table _time, All_Risk.search_name, All_Risk.calculated_risk_score, All_Risk.risk_message
| rename All_Risk.* as *
| sort _time

# --- ATT&CK technique coverage of accumulated risk ---
# Which techniques an entity has triggered, which is the difference
# between "twelve alerts" and "a kill chain".
| from datamodel Risk.All_Risk
| stats values(All_Risk.annotations.mitre_attack.mitre_technique_id) as techniques,
        dc(All_Risk.annotations.mitre_attack.mitre_technique_id) as technique_count
  by All_Risk.risk_object
| rename All_Risk.* as *
| where technique_count > 1
| sort - technique_count


# ============================================================
# CROSS-SOURCE CORRELATION
# ============================================================

# --- All activity for one address across every source ---
# Raw search is correct here: the point is to see everything, including
# sources with no CIM mapping. Replace <IP>.
(`botsv1_web` OR `botsv1_windows_security` OR `botsv1_ids`) "<IP>"
| eval log_source = case(
    index=="web_logs", "Web",
    index=="windows_security", "Windows",
    index=="ids_alerts", "Suricata IDS",
    1==1, index)
| table _time, log_source, sourcetype, _raw
| sort _time
